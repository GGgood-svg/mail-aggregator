{
  "name": "mail-aggregator",
  "version": "0.2.0",
  "private": true,
  "description": "Self-hosted IMAP aggregation and read-only Web mail panel powered by imapsync and Dovecot",
  "main": "server/app.js",
  "scripts": {
    "start": "node server/app.js",
    "init-db": "node server/db.js --init",
    "test": "node --test tests/*.test.js",
    "test:integration": "node tests/native-smoke.cjs",
    "test:maildir": "node --test tests/maildir-backup.integration.cjs",
    "test:dovecot": "node --test tests/dovecot.integration.cjs",
    "test:helper": "node --test tests/dovecot-helper.integration.cjs",
    "test:browser": "node --test tests/mail-browser.integration.cjs tests/notification-task-link.integration.cjs"
  },
  "license": "MIT",
  "keywords": [
    "email",
    "imap",
    "imapsync",
    "dovecot",
    "self-hosted"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GGgood-svg/mail-aggregator.git"
  },
  "bugs": {
    "url": "https://github.com/GGgood-svg/mail-aggregator/issues"
  },
  "homepage": "https://github.com/GGgood-svg/mail-aggregator#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.3.0",
    "cookie-parser": "^1.4.6",
    "express": "^4.22.2",
    "express-session": "^1.18.0",
    "imapflow": "^1.7.8",
    "mailparser": "3.12.4",
    "sanitize-html": "2.18.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
