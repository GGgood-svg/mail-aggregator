#!/sbin/openrc-run

name="mail-aggregator"
description="轻量邮件汇聚 Web 管理面板"

# 权限说明: 当前架构下 imapsync 通过标准 IMAP 协议连接本地 Dovecot
# (127.0.0.1:143),不需要读取 Dovecot 的任何本地文件或走特殊权限,
# 所以 mailadmin 不需要任何 sudo 权限,也不需要加入 dovecot 用户组。
# 如果你自己的环境有特殊需求(比如改成走本地socket/LDA投递),
# 请按最小权限原则单独配置,不要给 mailadmin 加 "ALL=(ALL) NOPASSWD:ALL" 这种。

APP_DIR="/opt/mail-aggregator"
APP_USER="mailadmin"

command="/usr/bin/node"
command_args="${APP_DIR}/server/app.js"
command_user="${APP_USER}:${APP_USER}"
command_background="yes"
pidfile="/run/mail-aggregator.pid"
output_log="/var/log/mail-aggregator.log"
error_log="/var/log/mail-aggregator.err.log"

directory="${APP_DIR}"

# Generated by install.sh. It intentionally contains no password.
[ -r /etc/mail-aggregator/config ] && . /etc/mail-aggregator/config
if [ -n "$WEB_PORT" ]; then export PORT="$WEB_PORT"; fi
export DOVECOT_USER DOVECOT_HOST DOVECOT_PORT WEB_LANGUAGE
export MAIL_AGG_BIND_HOST MAIL_AGG_TRUST_PROXY MAIL_AGG_COOKIE_SECURE MAIL_AGG_REQUIRE_HTTPS
export MAIL_AGG_SERVICE_MANAGER=openrc
export MAIL_AGG_DATA_DIR="/var/lib/mail-aggregator"

depend() {
    need net
    after dovecot
}

start_pre() {
    umask 077
    checkpath -f -m 0600 -o "${APP_USER}:${APP_USER}" "${output_log}" "${error_log}"
}

# openrc-run 默认 stop 动作会向主进程发 SIGTERM,
# server/app.js 里的 SIGTERM 处理器会负责: 停止调度器、尝试终止正在跑的
# imapsync子进程、关闭HTTP server,不需要在这里额外写 stop() 覆盖默认行为。
