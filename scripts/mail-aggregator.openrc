#!/sbin/openrc-run

name="mail-aggregator"
description="轻量邮件汇聚 Web 管理面板"

# 权限说明: 当前架构下 imapsync 通过标准 IMAP 协议连接本地 Dovecot
# (127.0.0.1:143),不需要读取 Dovecot 的任何本地文件或走特殊权限,
# 所以 mailadmin 不需要任何 sudo 权限,也不需要加入 dovecot 用户组。
# 如果你自己的环境有特殊需求(比如改成走本地socket/LDA投递),
# 请按最小权限原则单独配置,不要给 mailadmin 加 "ALL=(ALL) NOPASSWD:ALL" 这种。

APP_DIR="/opt/mail-aggregator"
APP_USER="mailadmin"

command="/usr/bin/node"
command_args="${APP_DIR}/server/app.js"
command_user="${APP_USER}:${APP_USER}"
command_background="yes"
pidfile="/run/mail-aggregator.pid"
output_log="/var/log/mail-aggregator.log"
error_log="/var/log/mail-aggregator.err.log"

directory="${APP_DIR}"

# Generated by install.sh. It intentionally contains no password.
# Parse through the same root-owned module used by the update executor.
mail_agg_settings_ok=no
if mail_agg_settings=$(/usr/bin/node /usr/local/lib/mail-aggregator-maintenance-data/web-config.js); then
    eval "$mail_agg_settings"
    mail_agg_settings_ok=yes
fi
unset mail_agg_settings
# The database owns web_port on both OpenRC and systemd. A deliberate PORT
# override supplied by the operator is still honored by the application.
export DOVECOT_USER DOVECOT_HOST DOVECOT_PORT WEB_LANGUAGE
export MAIL_AGG_BIND_HOST MAIL_AGG_TRUST_PROXY MAIL_AGG_COOKIE_SECURE MAIL_AGG_REQUIRE_HTTPS
export MAIL_AGG_SERVICE_MANAGER=openrc
export MAIL_AGG_DATA_DIR="/var/lib/mail-aggregator"
export MAIL_AGG_UPDATE_JOURNAL=/var/lib/mail-aggregator-updater/journal.json
export MAIL_AGG_MANUAL_UPDATE_JOURNAL=/var/lib/mail-aggregator-updater/manual-gate
export MAIL_AGG_UPDATE_CONTROL=/run/mail-aggregator-update-app/control.sock
export MAIL_AGG_HOST_MAINTENANCE_LOCK=/run/mail-aggregator-maintenance/lock
if grep -Eq '^3\.24(\.|$)' /etc/alpine-release && [ "$(uname -m)" = x86_64 ] && [ "$(/usr/bin/node -p 'process.versions.node.split(".")[0]')" = 24 ]; then
    export MAIL_AGG_UPDATE_SOCKET=/run/mail-aggregator-updater/rpc.sock
fi

depend() {
    need net
    after dovecot mail-aggregator-updater
}

start_pre() {
    [ "$mail_agg_settings_ok" = yes ] || { eerror "Invalid /etc/mail-aggregator/config; service not started."; return 1; }
    . /usr/local/lib/mail-aggregator-maintenance.sh || return 1
    prepare_mail_aggregator_maintenance || return 1
    if [ -e "$MAIL_AGG_UPDATE_JOURNAL" ] && [ ! -f /run/mail-aggregator-updater/start-permit ]; then
        eerror "An unresolved app update requires mail-aggregator-updater recovery before Web startup."
        return 1
    fi
    if [ -e "$MAIL_AGG_MANUAL_UPDATE_JOURNAL" ] && [ ! -f /run/mail-aggregator-maintenance/manual-start ]; then
        eerror "An unresolved manual update requires install.sh --recover-application."
        return 1
    fi
    umask 077
    checkpath -d -m 0700 -o "$APP_USER:$APP_USER" /run/mail-aggregator-update-app
    checkpath -f -m 0600 -o "${APP_USER}:${APP_USER}" "${output_log}" "${error_log}"
}

# openrc-run 默认 stop 动作会向主进程发 SIGTERM,
# server/app.js 里的 SIGTERM 处理器会负责: 停止调度器、尝试终止正在跑的
# imapsync子进程、关闭HTTP server,不需要在这里额外写 stop() 覆盖默认行为。
