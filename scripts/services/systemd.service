[Unit]
Description=Mail Aggregator Web management panel
After=network-online.target dovecot.service
Wants=network-online.target

[Service]
Type=simple
User=mailadmin
Group=mailadmin
WorkingDirectory=/opt/mail-aggregator
EnvironmentFile=-/etc/mail-aggregator/config
Environment=MAIL_AGG_DATA_DIR=/var/lib/mail-aggregator
Environment=MAIL_AGG_SERVICE_MANAGER=systemd
ExecStart=/usr/bin/node /opt/mail-aggregator/server/app.js
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
